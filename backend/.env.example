# Database (Neon.tech)
DATABASE_URL="postgresql://user:password@ep-cool-name-pooler.us-east-2.aws.neon.tech/neondb?pgbouncer=true&connect_timeout=15&sslmode=require"
DIRECT_URL="postgresql://user:password@ep-cool-name.us-east-2.aws.neon.tech/neondb?connect_timeout=15&sslmode=require"

# JWT
JWT_SECRET="your-super-secret-key-min-32-chars-here-1234567890"
JWT_REFRESH_SECRET="your-refresh-secret-key-min-32-chars-here-0987654321"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="PrintFlow Studio <noreply@printflow.com>"
